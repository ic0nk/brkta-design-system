{
  "name": "@brkta/platform-core",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./theme": {
      "types": "./dist/src/theme.d.ts",
      "default": "./dist/src/theme.js"
    },
    "./locale": {
      "types": "./dist/src/locale.d.ts",
      "default": "./dist/src/locale.js"
    },
    "./currency": {
      "types": "./dist/src/currency.d.ts",
      "default": "./dist/src/currency.js"
    },
    "./region": {
      "types": "./dist/src/region.d.ts",
      "default": "./dist/src/region.js"
    },
    "./preferences": {
      "types": "./dist/src/preferences.d.ts",
      "default": "./dist/src/preferences.js"
    },
    "./identity": {
      "types": "./dist/src/identity.d.ts",
      "default": "./dist/src/identity.js"
    },
    "./consent": {
      "types": "./dist/src/consent.d.ts",
      "default": "./dist/src/consent.js"
    },
    "./feature-flags": {
      "types": "./dist/src/feature-flags.d.ts",
      "default": "./dist/src/feature-flags.js"
    },
    "./date-time": {
      "types": "./dist/src/date-time.d.ts",
      "default": "./dist/src/date-time.js"
    },
    "./accessibility": {
      "types": "./dist/src/accessibility.d.ts",
      "default": "./dist/src/accessibility.js"
    }
  },
  "devDependencies": {
    "typescript": "^5",
    "vitest": "4.1.10"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ic0nk/brkta-design-system.git",
    "directory": "packages/platform-core"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
