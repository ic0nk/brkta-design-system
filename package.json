{
  "name": "brkta-design-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": { "node": ">=24.0.0 <25", "pnpm": ">=11.0.0 <12" },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify:pack": "node scripts/verify-pack.mjs",
    "storybook:react": "pnpm --dir packages/ui-react storybook",
    "storybook:angular": "pnpm --dir packages/ui-angular storybook",
    "release": "changeset publish"
  },
  "devDependencies": { "@changesets/cli": "^2.27.0", "typescript": "^5.9.3" }
}
